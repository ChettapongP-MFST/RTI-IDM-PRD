//     "MORNING_WORKING_HOUR",   "HOLIDAY",      -2500, -3500, -4500,
//     "AFTERNOON_WORKING_HOUR", "BUSINESS_DAY", -3500, -4500, -5500,
//     "AFTERNOON_WORKING_HOUR", "WEEKEND",      -3000, -4000, -5000,
//     "AFTERNOON_WORKING_HOUR", "HOLIDAY",      -2500, -3500, -4500,
//     "AFTER_WORKING_HOUR",     "BUSINESS_DAY", -3000, -4000, -5000,
//     "AFTER_WORKING_HOUR",     "WEEKEND",      -2500, -3500, -4500,
