// ============================================================================
// Production 09 - EWI Activator Example 1 (Option 1: source = Gold_EarlyWarning())
// Indicator #2 Net Outflow - Scope = TOTAL_BANK, latest 30-min bucket.
// ----------------------------------------------------------------------------
// Gold_EarlyWarning() emits LONG rows (one per Scope x bucket x indicator) and
// already assigns Alert_Level (L0-L3) from the EWI_AlertThreshold reference table
// (per Window x DayType). So Activator just watches Alert_Level - no thresholds
// typed in the UI, and no per-window datatable needed here.
//
//   Activator item : act-deposit-ewi
//   Rule name      : rule_NetOutflow_MB_alert
//   Object         : Object_Id = "TOTAL_BANK|NetOutflow_MB"
//
// Run in the DepositMovement KQL database; use this block as the source.
// ============================================================================

Gold_EarlyWarning()
| where Scope == "TOTAL_BANK" and IndicatorKey == "NetOutflow_MB"
| summarize arg_max(Bucket_Start, *) by Object_Id     // latest 30-min bucket
| project Object_Id, Scope, Date_ICT, Bucket_Label, WindowCode, DayType,
          Value, L1, L2, L3, Alert_Level, Alert_Rank

// ----------------------------------------------------------------------------
// ACTIVATOR SETUP (Option 1 - KQL Queryset -> Add alert -> open Activator item)
//   Activator item  : act-deposit-ewi
//   Rule name       : rule_NetOutflow_MB_alert
//   Object          : Object_Id  (here "TOTAL_BANK|NetOutflow_MB")
//   Condition       : Alert_Level  ->  is one of  "L2", "L3"
//                     (or Alert_Rank >= 2 ; the level already encodes the
//                      Window x DayType threshold from EWI_AlertThreshold)
//   Actions         : Email / Teams, with Value / WindowCode / DayType /
//                     Alert_Level as dynamic content in the message
//   Evaluate every  : 30 minutes
//
// RETUNE: edit production/04-gold-summary-table/data/ewi-alert-threshold.csv,
// re-run the melt script, then re-run kql/17-load-EWI_AlertThreshold.kql.
// No rule change - the level recomputes from the new thresholds.
// ----------------------------------------------------------------------------

// ----------------------------------------------------------------------------
// Optional: watch ALL indicators for TOTAL_BANK at once (one row per indicator).
// Object = Object_Id (= Scope|IndicatorKey); rule fires on Alert_Level in (L2,L3).
// ----------------------------------------------------------------------------
// Gold_EarlyWarning()
// | where Scope == "TOTAL_BANK"
// | summarize arg_max(Bucket_Start, *) by Object_Id
// | project Object_Id, Scope, IndicatorKey, Bucket_Label, WindowCode, DayType,
//           Value, Alert_Level, Alert_Rank
