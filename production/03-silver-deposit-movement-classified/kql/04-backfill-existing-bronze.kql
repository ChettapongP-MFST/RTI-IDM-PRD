// OPTIONAL one-time backfill for Bronze rows that existed before the update policy.
//
// Safety rule: run the count check first. Execute the append only when Silver is
// empty; rerunning it appends duplicate classified rows. Keep the update policy
// enabled so Bronze rows arriving during the backfill are still classified.
//
// Schema upgrade: .create-merge adds IsBusinessDay but does not populate it on
// existing Silver rows. To upgrade a populated table, pause Bronze ingestion,
// disable the update policy, clear Silver, deploy scripts 01 and 02, re-enable
// the policy with script 03, and then execute this backfill once.

DepositMovementClassified
| summarize SilverRowCount = count()

// Expected before first backfill: SilverRowCount == 0.
// Uncomment and run this command once only:
// .set-or-append DepositMovementClassified <| Transform_DepositMovementClassified()

DepositMovementClassified
| summarize
    SilverRowCount = count(),
    EarliestDate = min(Date),
    LatestDate = max(Date),
    LatestLoadTimestamp = max(load_ts)
