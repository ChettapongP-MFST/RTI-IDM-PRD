// OPTIONAL: only for deployments that already use DepositMovementEarlyWarning.
// Skip this file when EWI is queried directly through Gold_EarlyWarning().
// Prerequisites: 01-create-CR01-serving-gates.kql and the persisted EWI table.
// This command does not create, populate, or repair that table.
.create-or-alter function with (folder="CR01")
CR01_EarlyWarning_StoredLatest()
{
    let ready=toscalar(CR01_PublishState | top 1 by ChangedAtUtc desc | project IsReady);
    let closed=bin(now()+7h,30m)-30m;
    DepositMovementEarlyWarning
    | where ready==true and Bucket_Start==closed
}
