{
  "properties": {
    "activities": [
      {
        "type": "Script",
        "linkedService": {
          "name": "wh_control_framework",
          "properties": {
            "annotations": [],
            "type": "DataWarehouse",
            "typeProperties": {
              "endpoint": "k35aq6omcxkejht6cuywxdyb4q-hnymx4hlfrzuviycqeyfpqdeci.datawarehouse.fabric.microsoft.com",
              "artifactId": "141c432a-2e04-4a09-9201-4bcf091cc0a9",
              "workspaceId": "f0cb703b-2ceb-4a73-a302-813057c06412"
            }
          }
        },
        "name": "Validate Controller Owner",
        "dependsOn": [],
        "policy": {
          "secureOutput": false,
          "retry": 0,
          "timeout": "0.01:00:00",
          "secureInput": false
        },
        "typeProperties": {
          "scriptBlockExecutionTimeout": "01:00:00",
          "scripts": [
            {
              "text": "IF (SELECT COUNT(*) FROM dbo.CR01ControllerRun\r\n    WHERE RunId=@ControllerRunId AND Status='Running') <> 1\r\n    THROW 51100, 'CR01 internal pipeline requires an active controller owner.', 1;",
              "parameters": [
                {
                  "direction": "Input",
                  "value": {
                    "value": "@pipeline().parameters.pControllerRunId",
                    "type": "Expression"
                  },
                  "name": "ControllerRunId",
                  "type": "String"
                }
              ],
              "type": "NonQuery"
            }
          ]
        }
      },
      {
        "name": "Set vToday",
        "type": "SetVariable",
        "dependsOn": [
          {
            "activity": "Validate Controller Owner",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "variableName": "vToday",
          "value": {
            "value": "@concat('INTRADAY_SUMMARY_', formatDateTime(pipeline().parameters.pRunICT, 'yyyyMMdd'))",
            "type": "Expression"
          }
        }
      },
      {
        "dependsOn": [
          {
            "activity": "Set vToday",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "variableName": "vYesterday",
          "value": {
            "value": "@concat('INTRADAY_SUMMARY_', formatDateTime(addDays(pipeline().parameters.pRunICT,-1),'yyyyMMdd'))",
            "type": "Expression"
          }
        },
        "name": "Set vYesterday",
        "type": "SetVariable"
      },
      {
        "name": "Get Metadata List Files",
        "type": "GetMetadata",
        "dependsOn": [
          {
            "activity": "Set vYesterday",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 2,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "fieldList": [
            "childItems"
          ],
          "datasetSettings": {
            "annotations": [],
            "type": "Binary",
            "typeProperties": {
              "location": {
                "type": "AzureBlobFSLocation",
                "folderPath": "inbound/statement",
                "fileSystem": "inflowoutflow"
              }
            },
            "externalReferences": {
              "connection": "52065620-a202-4b92-8215-c348e25a8c2c"
            }
          },
          "storeSettings": {
            "type": "AzureBlobFSReadSettings",
            "recursive": true,
            "enablePartitionDiscovery": false
          },
          "formatSettings": {
            "type": "BinaryReadSettings"
          }
        }
      },
      {
        "name": "Lookup Processed Files",
        "type": "Lookup",
        "dependsOn": [
          {
            "activity": "Get Metadata List Files",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 2,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "source": {
            "type": "DataWarehouseSource",
            "sqlReaderQuery": {
              "value": "SELECT COALESCE('|' + STRING_AGG(FileName, '|') + '|', '|') AS ProcessedList\nFROM dbo.ProcessedFiles\nWHERE Status = 'Success'\n  AND (FileName LIKE '@{variables('vToday')}%' OR FileName LIKE '@{variables('vYesterday')}%');",
              "type": "Expression"
            },
            "queryTimeout": "02:00:00",
            "partitionOption": "None"
          },
          "datasetSettings": {
            "annotations": [],
            "linkedService": {
              "name": "wh_control_framework",
              "properties": {
                "annotations": [],
                "type": "DataWarehouse",
                "typeProperties": {
                  "endpoint": "k35aq6omcxkejht6cuywxdyb4q-hnymx4hlfrzuviycqeyfpqdeci.datawarehouse.fabric.microsoft.com",
                  "artifactId": "141c432a-2e04-4a09-9201-4bcf091cc0a9",
                  "workspaceId": "f0cb703b-2ceb-4a73-a302-813057c06412"
                }
              }
            },
            "type": "DataWarehouseTable",
            "schema": [],
            "typeProperties": {}
          }
        }
      },
      {
        "name": "Filter New Files",
        "type": "Filter",
        "dependsOn": [
          {
            "activity": "Lookup Processed Files",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@activity('Get Metadata List Files').output.childItems",
            "type": "Expression"
          },
          "condition": {
            "value": "@and(and(equals(item().type,'File'),or(startswith(item().name,variables('vToday')),startswith(item().name,variables('vYesterday')))),and(endswith(toLower(item().name),'.csv'),not(contains(activity('Lookup Processed Files').output.firstRow.ProcessedList,concat('|',item().name,'|')))))",
            "type": "Expression"
          }
        }
      },
      {
        "name": "ForEach New Files",
        "type": "ForEach",
        "dependsOn": [
          {
            "activity": "Filter New Files",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@activity('Filter New Files').output.Value",
            "type": "Expression"
          },
          "batchCount": 10,
          "activities": [
            {
              "name": "Invoke Ingestion",
              "type": "InvokePipeline",
              "dependsOn": [],
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "waitOnCompletion": true,
                "operationType": "InvokeFabricPipeline",
                "pipelineId": "0a74b40a-6e71-4a66-9cb1-d49a6d405d01",
                "workspaceId": "f0cb703b-2ceb-4a73-a302-813057c06412",
                "parameters": {
                  "pFileName": {
                    "value": "@item().name",
                    "type": "Expression"
                  },
                  "pFolder": "inbound/statement",
                  "Subject": {
                    "value": "@concat('/blobServices/default/containers/inflowoutflow/blobs/inbound/statement/', item().name)",
                    "type": "Expression"
                  }
                }
              },
              "externalReferences": {
                "connection": "eb7f93f8-354c-4960-9b42-9ff505825f47"
              }
            }
          ]
        }
      }
    ],
    "parameters": {
      "pControllerRunId": {
        "type": "string"
      },
      "pRunICT": {
        "type": "string"
      }
    },
    "variables": {
      "vToday": {
        "type": "String"
      },
      "vYesterday": {
        "type": "String"
      }
    }
  }
}
