        "typeProperties": {
          "activities": [
            {
              "name": "Lookup Next Refresh",
              "type": "Lookup",
              "dependsOn": [],
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "source": {
                  "type": "DataWarehouseSource",
                  "sqlReaderQuery": {
                    "value": "DECLARE @first DATE=TRY_CONVERT(DATE,'@{variables('vFirstRefreshDate')}',23);\r\nIF @first IS NULL THROW 51105,'Invalid first refresh date.',1;\r\nDECLARE @now DATETIME2(6)='@{variables('vRunICT')}';\r\nDECLARE @due DATE=CAST(DATEADD(DAY,CASE WHEN CAST(@now AS TIME)<'03:30' THEN -1 ELSE 0 END,@now) AS DATE);\r\nDECLARE @last DATE=(SELECT MAX(RefreshDate) FROM dbo.CR01RefreshRun WHERE Status='Completed');\r\nDECLARE @next DATE=CASE WHEN @last IS NULL THEN @first ELSE DATEADD(DAY,1,@last) END;\r\nIF EXISTS(SELECT 1 FROM dbo.CR01RefreshRun WHERE Status<>'Completed')\r\n    THROW 51106,'An incomplete refresh requires recovery with its original manifest.',1;\r\nSELECT CASE WHEN @next<=@due THEN 1 ELSE 0 END AS HasDue,CONVERT(VARCHAR(10),@next,23) AS RefreshDate;",
                    "type": "Expression"
                  },
                  "queryTimeout": "02:00:00",
                  "partitionOption": "None"
                },
                "firstRowOnly": true,
                "datasetSettings": {
                  "annotations": [],
                  "linkedService": {
                    "name": "wh_control_framework",
                    "properties": {
                      "annotations": [],
                      "type": "DataWarehouse",
                      "typeProperties": {
                        "endpoint": "k35aq6omcxkejht6cuywxdyb4q-hnymx4hlfrzuviycqeyfpqdeci.datawarehouse.fabric.microsoft.com",
                        "artifactId": "141c432a-2e04-4a09-9201-4bcf091cc0a9",
                        "workspaceId": "f0cb703b-2ceb-4a73-a302-813057c06412"
                      }
                    }
                  },
                  "type": "DataWarehouseTable",
                  "schema": [],
                  "typeProperties": {}
                }
              }
            },
            {
              "dependsOn": [
                {
                  "activity": "Lookup Next Refresh",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "typeProperties": {
                "expression": {
                  "value": "@equals(int(activity('Lookup Next Refresh').output.firstRow.HasDue),1)",
                  "type": "Expression"
                },
                "ifTrueActivities": [
                  {
                    "name": "Invoke Overnight Refresh",
