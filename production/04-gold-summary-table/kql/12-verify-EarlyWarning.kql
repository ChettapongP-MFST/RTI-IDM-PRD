// ============================================================================
// Production 04 - Gold EWI verification (self-contained function, long output).
// Run in the DepositMovement KQL database. Replace datetime(2026-06-01) with a
// business date that exists in your Silver data, or omit for today (ICT).
// ============================================================================

// 1. Objects exist.
.show materialized-view mv_DepositMovementEarlyWarning
.show function Gold_EarlyWarning
.show table EWI_AlertThreshold

// 2. Threshold table sanity: 288 rows total, 96 per scope. Expected: 3 rows of 96.
EWI_AlertThreshold
| summarize Rows = count() by Scope

// 2b. Base MV grain: one row per (Date, Bucket, IsRetail). Expected: no rows.
mv_DepositMovementEarlyWarning
| summarize c = count() by LocalDate, BucketStart, IsRetail
| where c > 1

// 3. Long grain: exactly one row per (Object_Id, Bucket_Start, IndicatorId). Expected: no rows.
Gold_EarlyWarning(datetime(2026-06-01))
| summarize c = count() by Object_Id, Bucket_Start, IndicatorId
| where c > 1

// 4. Every bucket has 24 rows = 3 scopes x 8 indicators. Expected: no rows.
Gold_EarlyWarning(datetime(2026-06-01))
| summarize Rows = count() by Bucket_Start
| where Rows != 24

// 5. Silver reconciliation: TOTAL_BANK periodic net (sum of NetOutflow_MB across
// buckets) equals Silver net (channel-excluded) for the date. Expected: no rows.
let _d = datetime(2026-06-01);
let _silverNet = toscalar(
    DepositMovementClassified
    | where LocalDate == _d and isnotnull(LocalDateTime) and Channel !in ("MSYG", "SYSG")
    | summarize sum(Net_Amount)) / 1000000.0;
let _goldNet = toscalar(
    Gold_EarlyWarning(_d)
    | where Scope == "TOTAL_BANK" and IndicatorKey == "NetOutflow_MB"
    | summarize sum(Value));
print SilverNet_MB = _silverNet, GoldNet_MB = _goldNet, Diff = round(_goldNet - _silverNet, 2)
| where abs(Diff) > 0.01

// 6. Retails + Non-Retails cluster shares sum to ~100% per bucket (draining periods).
// Expected: no rows.
Gold_EarlyWarning(datetime(2026-06-01))
| where IndicatorKey == "ClusterShare_Pct" and Scope in ("RETAILS", "NON_RETAILS") and isnotnull(Value)
| summarize TotalShare = round(sum(Value), 1) by Bucket_Start
| where TotalShare != 100.0

// 7. Accum reconciliation: for TOTAL_BANK the AccumNetOutflow delta between
// consecutive buckets equals the bucket NetOutflow. Expected: no rows.
let _accum = Gold_EarlyWarning(datetime(2026-06-01))
    | where Scope == "TOTAL_BANK" and IndicatorKey == "AccumNetOutflow_MB"
    | project Bucket_Start, Accum = Value;
let _net = Gold_EarlyWarning(datetime(2026-06-01))
    | where Scope == "TOTAL_BANK" and IndicatorKey == "NetOutflow_MB"
    | project Bucket_Start, Net = Value;
_accum
| join kind=inner _net on Bucket_Start
| order by Bucket_Start asc
| serialize
| extend Delta = round(Accum - prev(Accum), 2)
| where isnotnull(prev(Accum)) and Delta != round(Net, 2)
| project Bucket_Start, Net, Accum, Delta

// 8. Alert_Level integrity: only L0-L3, and Alert_Rank matches. Expected: no rows.
Gold_EarlyWarning(datetime(2026-06-01))
| where Alert_Level !in ("L0", "L1", "L2", "L3")
    or Alert_Rank != case(Alert_Level == "L3", 3, Alert_Level == "L2", 2, Alert_Level == "L1", 1, 0)

// 9. Threshold coverage: every emitted row matched a threshold row (Direction not
// null). Expected: no rows (the 288-row table covers all combinations).
Gold_EarlyWarning(datetime(2026-06-01))
| where isnull(Direction)
| summarize Missing = count() by Scope, IndicatorKey, WindowCode, DayType

// 10. Level distribution for review (how many rows at each level).
Gold_EarlyWarning(datetime(2026-06-01))
| summarize Rows = count() by IndicatorKey, Alert_Level
| order by IndicatorKey asc, Alert_Level asc

// 11. Expanding velocity variant (N=0) runs without error, for comparison.
Gold_EarlyWarning(datetime(2026-06-01), 0)
| where Scope == "TOTAL_BANK" and IndicatorKey == "Velocity_X"
| project Bucket_Label, Value, Alert_Level
| order by Bucket_Label asc
