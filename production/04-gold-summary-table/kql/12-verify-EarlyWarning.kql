// ============================================================================
// Production 04 - Gold EWI verification. Run in the DepositMovement KQL database.
// Replace datetime(2026-06-01) with a business date that exists in your Silver
// data (e.g. a generated mock date), or call Gold_EarlyWarning() for today (ICT).
// ============================================================================

// 1. Objects exist.
.show materialized-view mv_EarlyWarning_Base
.show function Gold_EarlyWarning

// 2. Base MV grain: exactly one row per (Date, Bucket, IsRetail). Expected: no rows.
mv_EarlyWarning_Base
| summarize c = count() by LocalDate, BucketStart, IsRetail
| where c > 1

// 3. Base view reconciles with Silver (channel-excluded) for one date. Expected: no rows.
let _d = datetime(2026-06-01);
let _silverNet = toscalar(
    DepositMovementClassified
    | where LocalDate == _d and isnotnull(LocalDateTime) and Channel !in ("MSYG", "SYSG")
    | summarize sum(Net_Amount));
let _baseNet = toscalar(
    mv_EarlyWarning_Base | where LocalDate == _d | summarize sum(Net));
print SilverNet = _silverNet, BaseNet = _baseNet, Diff = _baseNet - _silverNet
| where Diff != decimal(0)

// 4. Preview one date across all scopes.
Gold_EarlyWarning(datetime(2026-06-01))
| order by Scope asc, Bucket_Start asc

// 5. Three scopes present for every bucket. Expected: no rows.
Gold_EarlyWarning(datetime(2026-06-01))
| summarize Scopes = dcount(Scope) by Bucket_Label
| where Scopes != 3

// 6. Retails + Non-Retails cluster shares sum to ~100% per bucket (draining periods).
// Expected: no rows.
Gold_EarlyWarning(datetime(2026-06-01))
| where Scope in ("RETAILS", "NON_RETAILS") and isnotnull(ClusterShare_Pct)
| summarize TotalShare = round(sum(ClusterShare_Pct), 1) by Bucket_Label
| where TotalShare != 100.0

// 7. Accumulated net outflow reconciles with the running sum of periodic net.
// For TOTAL_BANK, AccumNetOutflow delta must equal the bucket NetOutflow. Expected: no rows.
Gold_EarlyWarning(datetime(2026-06-01))
| where Scope == "TOTAL_BANK"
| order by Bucket_Start asc
| serialize
| extend Delta = round(AccumNetOutflow_MB - prev(AccumNetOutflow_MB), 2)
| where isnotnull(prev(AccumNetOutflow_MB)) and Delta != round(NetOutflow_MB, 2)
| project Bucket_Label, NetOutflow_MB, AccumNetOutflow_MB, Delta

// 8. Velocity (N=4) and digest columns for TOTAL_BANK, for review.
Gold_EarlyWarning(datetime(2026-06-01))
| where Scope == "TOTAL_BANK"
| project Bucket_Label, DebitTxnCount_M, Velocity_X, AvgDebitAmount_KThb, NetOutflow_Bn, AccumNetOutflow_Bn
| order by Bucket_Label asc

// 9. Expanding velocity variant (N=0) runs without error, for comparison.
Gold_EarlyWarning(datetime(2026-06-01), 0)
| where Scope == "TOTAL_BANK"
| project Bucket_Label, DebitTxnCount_M, Velocity_X
| order by Bucket_Label asc
