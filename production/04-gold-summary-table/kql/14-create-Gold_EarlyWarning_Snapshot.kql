// ============================================================================
// Production 04 - Gold EWI persisted snapshot table: Gold_EarlyWarning_Snapshot
// ----------------------------------------------------------------------------
// Physical Gold table that STORES the Gold_EarlyWarning() output, one row per
// Scope x 30-min bucket. A 30-minute scheduled job appends new buckets (see
// 15-append-Gold_EarlyWarning_Snapshot.kql). Data Activator and Power BI read
// THIS table, so the enriched rows (cumulative / velocity / cluster share /
// sudden jump) are persisted for history, dashboards, backtesting, and the
// Trigger-Amount percentile calibration.
//
// Schema mirrors the Gold_EarlyWarning() projection exactly.
// Run in the DepositMovement KQL database.
// ============================================================================

.create-merge table Gold_EarlyWarning_Snapshot (
    Object_Id:           string,
    Date_ICT:            string,
    Bucket_Start:        datetime,
    Bucket_Label:        string,
    Alert_Time:          datetime,
    Scope:               string,
    WindowCode:          string,
    WindowName:          string,
    DayType:             string,
    EventFlag:           string,
    IsMonthEnd:          bool,
    IsPayroll:           bool,
    IsLongWeekend:       bool,
    GrossOutflow_MB:     real,
    NetOutflow_MB:       real,
    AccumNetOutflow_MB:  real,
    DebitTxnCount_M:     real,
    Velocity_X:          real,
    AvgDebitAmount_KThb: real,
    ClusterShare_Pct:    real,
    ShareJump_Pct:       real,
    NetOutflow_Bn:       real,
    AccumNetOutflow_Bn:  real
)
with (folder = "Gold")

// Keep two years of intraday history for dashboards and calibration; cache 90 days hot.
.alter table Gold_EarlyWarning_Snapshot policy retention softdelete = 730d recoverability = enabled
.alter table Gold_EarlyWarning_Snapshot policy caching hot = 90d
