// ============================================================================
// Production 04 - Gold EWI base materialized view: mv_EarlyWarning_Base
// ----------------------------------------------------------------------------
// 30-minute PERIODIC aggregates on Silver DepositMovementClassified, split by
// Retails vs Non-Retails, with channels MSYG / SYSG excluded from all math.
// This is the additive foundation only. Cumulative net, velocity, cluster
// share, and sudden-share-jump are computed at query time in Gold_EarlyWarning()
// because a materialized view cannot use window functions.
//
// Run in the KQL Database "DepositMovement" (inside Eventhouse eh-rti-deposit).
//
// Grain : LocalDate x BucketStart(30m) x IsRetail
// Retail: Channel in ('ENET','ATM','CDM')  (configurable)
// ============================================================================

.create materialized-view with (backfill=true, folder="Gold") mv_EarlyWarning_Base on table DepositMovementClassified
{
    DepositMovementClassified
    // Only rows with a valid local time can fall into a 30-minute bucket.
    | where isnotnull(LocalDateTime)
    // Main condition #1: exclude MSYG / SYSG from every calculation.
    | where Channel !in ("MSYG", "SYSG")
    | extend
        IsRetail    = Channel in ("ENET", "ATM", "CDM"),
        BucketStart = bin(LocalDateTime, 30m)
    | summarize
        GrossOutflow = sum(Debit_Amount),
        Credit       = sum(Credit_Amount),
        Net          = sum(Net_Amount),
        DebitTxn     = sum(Debit_Transaction),
        UpdatedAtUtc = max(load_ts)
        by LocalDate, BucketStart, DayClassification, EventFlag,
           IsMonthEnd, IsPayroll, IsLongWeekend, IsRetail
}

// Silver is derived data; keep the base view cached and retained like the Gold layer.
.alter materialized-view mv_EarlyWarning_Base policy caching hot = 90d
