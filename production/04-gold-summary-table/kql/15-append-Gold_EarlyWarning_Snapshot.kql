// ============================================================================
// Production 04 - Gold EWI snapshot append (idempotent). Run every 30 minutes.
// ----------------------------------------------------------------------------
// Runs Gold_EarlyWarning() for today (ICT) and appends only the (Scope, bucket)
// rows not already stored in Gold_EarlyWarning_Snapshot, so re-running the same
// cycle adds nothing (idempotent). A late bucket that lands after its cycle is
// picked up on the next run.
//
// SCHEDULING: a materialized view / update policy cannot produce these rows
// (they need window functions - cumulative / velocity / jump). Schedule this
// every 30 minutes with a Fabric Data Pipeline that invokes a Notebook which
// executes the .set-or-append below against the Eventhouse - the same
// scheduled-pipeline pattern as Production 07 (interval scheduler).
//
// Run / verify manually in the DepositMovement KQL database.
// ============================================================================

.set-or-append Gold_EarlyWarning_Snapshot <|
    let _today = startofday(now() + 7h);
    let _existing = toscalar(
        Gold_EarlyWarning_Snapshot
        | where Bucket_Start >= _today
        | summarize make_set(strcat(Scope, "|", format_datetime(Bucket_Start, "yyyy-MM-dd HH:mm"))));
    Gold_EarlyWarning()
    | where not(set_has_element(_existing, strcat(Scope, "|", format_datetime(Bucket_Start, "yyyy-MM-dd HH:mm"))))

// ----------------------------------------------------------------------------
// Optional: backfill history into the snapshot for a specific past date.
// Idempotent per (Scope, bucket) for that date. Uncomment and set the date.
