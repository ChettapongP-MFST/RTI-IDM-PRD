// ============================================================================
// Production 04 - Gold EWI persisted table: DepositMovementEarlyWarning
// ----------------------------------------------------------------------------
// Physical Gold table that STORES the Gold_EarlyWarning() output in LONG form:
// one row per Scope x 30-min bucket x indicator, with the assigned Alert_Level.
// A 30-minute scheduled job appends new rows (see
// 15-append-DepositMovementEarlyWarning.kql). Data Activator and Power BI read
// THIS table.
//
// Flow:  DepositMovementClassified (Silver) -> Gold_EarlyWarning() -> this table.
// Schema mirrors the Gold_EarlyWarning() projection exactly.
// Run in the DepositMovement KQL database (inside Eventhouse eh-rti-deposit).
// ============================================================================

.create-merge table DepositMovementEarlyWarning (
    Object_Id:      string,
    Scope:          string,
    Date_ICT:       string,
    Bucket_Start:   datetime,
    Bucket_Label:   string,
    Alert_Time:     datetime,
    WindowCode:     string,
    WindowName:     string,
    DayType:        string,
    EventFlag:      string,
    IsMonthEnd:     bool,
    IsPayroll:      bool,
    IsLongWeekend:  bool,
    IndicatorId:    int,
    IndicatorKey:   string,
    IndicatorName:  string,
    Unit:           string,
    Value:          real,
    Direction:      string,
    L1:             real,
    L2:             real,
    L3:             real,
    Alert_Level:    string,
    Alert_Rank:     int,
    Alert_Level_Name: string
)
with (folder = "Gold")

// Keep two years of intraday history for dashboards and calibration; cache 90 days hot.
.alter-merge table DepositMovementEarlyWarning policy retention softdelete = 730d recoverability = enabled
.alter table DepositMovementEarlyWarning policy caching hot = 90d
